{
  "name": "@room-booking/frontend",
  "description": "Quorum room booking front",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build-storybook": "storybook build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test.unit": "vitest components",
    "test.unit.ui": "vitest --ui components",
    "typecheck": "tsc --noEmit",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@eslint/js": "^9",
    "@storybook/addon-essentials": "^8.2.8",
    "@storybook/addon-links": "^8.2.8",
    "@storybook/blocks": "^8.2.8",
    "@storybook/builder-vite": "^8.2.8",
    "@storybook/html": "^8.2.8",
    "@storybook/html-vite": "^8.2.8",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "20.19.0",
    "@vitest/ui": "^0.34.6",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "qwik-image": "^1.0.0",
    "storybook": "^8.2.8",
    "storybook-framework-qwik": "^0.4.0",
    "tailwindcss": "^4.1.4",
    "typescript": "5.4.5",
    "typescript-eslint": "8.70.1",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^0.34.6",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@room-booking/core": "workspace:*"
  }
}
